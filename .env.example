BOT_TOKEN=your_bot_token_from_botfather
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
RECENT_USER_MESSAGES=10
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_tutor
# Список Telegram user id админов (через запятую, без пробелов или с пробелами)
ADMIN_TELEGRAM_IDS=5411010336

# Платёжный провайдер: stripe (по умолчанию, есть sandbox) или yookassa
PAYMENT_PROVIDER=stripe
# URL, куда перенаправить пользователя после оплаты (например ссылка на бота)
PAYMENT_RETURN_URL=https://t.me/your_bot_username

# --- Stripe (sandbox: используйте тестовые ключи из dashboard.stripe.com) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- ЮKassa (https://yookassa.ru/developers, тестовый контур) ---
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_SECRET_KEY=your_secret_key

# Веб-сервис (FastAPI) — только вебхуки платёжных провайдеров
WEB_HOST=0.0.0.0
WEB_PORT=8000
